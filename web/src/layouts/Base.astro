---
import {href} from '../lib/sanity'

const {title, description, active, settings} = Astro.props
const nav = [
  {key: 'start', label: 'Start', target: ''},
  {
    key: 'kurse',
    label: 'Kurse & Preise',
    target: 'kurse',
    children: [
      ['Wochenplan & Termine', 'kurse#wochenplan'],
      ['Preise', 'kurse#preise'],
      ['Welpengruppe', 'kurse#welpengruppe'],
      ['Junghunde', 'kurse#junghunde'],
      ['Hab8!', 'kurse#hab8'],
      ['Ha(l)b 8 - kleine Hunde', 'kurse#halb8'],
      ['Kleine Helden', 'kurse#kleine-helden'],
      ['Social Walk', 'kurse#social-walk'],
      ['Freilauf', 'kurse#freilauf'],
      ['Hoopers', 'kurse#hoopers'],
      ['Longieren', 'kurse#longieren'],
      ['Agility', 'kurse#agility'],
      ['Degility', 'kurse#degility'],
      ['Rally-Obedience', 'kurse#rally-obedience'],
      ['Einzelstunde', 'kurse#einzelstunde'],
      ['Maulkorbtraining', 'kurse#maulkorbtraining'],
      ['Hundeführerschein', 'kurse#hundefuehrerschein'],
    ],
  },
  {
    key: 'events',
    label: 'Events',
    target: 'events',
    children: [
      ['Krimiwanderung', 'events#krimiwanderung'],
      ['Dog Dance', 'events#dog-dance'],
      ['Kids- & Teens-Club', 'events#clubs'],
      ['Seminare', 'events#seminare'],
      ['Stammtisch', 'events#stammtisch'],
      ['Gutscheine', 'events#gutscheine'],
    ],
  },
  {key: 'hero4hair', label: 'Hero4Hair', target: 'hero4hair'},
  {key: 'ueber', label: 'Über uns', target: 'ueber-uns'},
  {key: 'galerie', label: 'Galerie', target: 'galerie'},
  {key: 'kontakt', label: 'Kontakt', target: 'kontakt'},
]

const s = settings || {}
const wa = s.whatsapp || '4915734777688'
const phoneLabel = s.phone || '01573 4 777 688'
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}assets/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}assets/css/style.css`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href('')}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 100 100"
              ><circle cx="17" cy="38" r="10" /><circle cx="38" cy="22" r="11" /><circle
                cx="63"
                cy="22"
                r="11"
              /><circle cx="84" cy="38" r="9" /><path
                d="M50 42c15 0 27 12 27 26 0 11-8 19-19 19-4 0-6-1-8-3-2 2-4 3-8 3-11 0-19-8-19-19 0-14 12-26 27-26z"
              /></svg>
          </span>
          <span class="brand-text"
            ><strong>{s.businessName || 'Hero4Paws'}</strong><span
              >{s.legalName || 'Hundeschule Katja Heldt'}</span
            ></span
          >
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="mainnav" aria-label="Menü öffnen"
          ><span></span></button
        >
        <nav class="nav" id="mainnav" aria-label="Hauptmenü">
          {
            nav.map((item) =>
              item.children ? (
                <div class="has-drop">
                  <a
                    class="nav-link"
                    href={href(item.target)}
                    aria-current={active === item.key ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                  <div class={`dropdown ${item.children.length > 8 ? 'cols-2' : ''}`}>
                    {item.children.map(([label, target]) => (
                      <a href={href(target)}>{label}</a>
                    ))}
                  </div>
                </div>
              ) : (
                <a
                  class="nav-link"
                  href={href(item.target)}
                  aria-current={active === item.key ? 'page' : undefined}
                >
                  {item.label}
                </a>
              )
            )
          }
        </nav>
        <a class="btn btn-primary header-cta" href={href('kontakt')}>Kurs anfragen</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">
              <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 100 100"
                  ><circle cx="17" cy="38" r="10" /><circle cx="38" cy="22" r="11" /><circle
                    cx="63"
                    cy="22"
                    r="11"
                  /><circle cx="84" cy="38" r="9" /><path
                    d="M50 42c15 0 27 12 27 26 0 11-8 19-19 19-4 0-6-1-8-3-2 2-4 3-8 3-11 0-19-8-19-19 0-14 12-26 27-26z"
                  /></svg>
              </span>
              <strong>{s.businessName || 'Hero4Paws'}</strong>
            </div>
            <p style="margin-bottom:.6rem">
              {s.claim || 'Mit Herz. Mit Wissen. Für euch.'}<br />{s.footerText}
            </p>
            <p style="margin:0">
              {
                s.instagramUrl && (
                  <a href={s.instagramUrl} rel="noopener">
                    Instagram
                  </a>
                )
              }
              {s.instagramUrl && s.facebookUrl ? ' · ' : ''}
              {
                s.facebookUrl && (
                  <a href={s.facebookUrl} rel="noopener">
                    Facebook
                  </a>
                )
              }
            </p>
          </div>
          <div>
            <h3>Kurse</h3>
            <ul class="footer-list">
              <li><a href={href('kurse#welpengruppe')}>Welpengruppe</a></li>
              <li><a href={href('kurse#junghunde')}>Junghunde</a></li>
              <li><a href={href('kurse#degility')}>Degility</a></li>
              <li><a href={href('kurse#hoopers')}>Hoopers</a></li>
              <li><a href={href('kurse#rally-obedience')}>Rally-Obedience</a></li>
              <li><a href={href('kurse#social-walk')}>Social Walk</a></li>
              <li><a href={href('kurse')}>Alle Kurse &amp; Preise</a></li>
            </ul>
          </div>
          <div>
            <h3>Hundeschule</h3>
            <ul class="footer-list">
              <li><a href={href('ueber-uns')}>Über uns</a></li>
              <li><a href={href('events#krimiwanderung')}>Krimiwanderung mit Hund</a></li>
              <li><a href={href('events#seminare')}>Seminare</a></li>
              <li><a href={href('kurse#hundefuehrerschein')}>Hundeführerschein</a></li>
              <li><a href={href('hero4hair')}>Hero4Hair</a></li>
              <li><a href={href('galerie')}>Galerie &amp; Presse</a></li>
            </ul>
          </div>
          <div>
            <h3>Kontakt</h3>
            <ul class="footer-list">
              <li><a href={`tel:+${wa}`}>{phoneLabel}</a></li>
              <li><a href={`https://wa.me/${wa}`} rel="noopener">WhatsApp schreiben</a></li>
              <li><a href={`mailto:${s.email}`}>{s.email}</a></li>
              <li>
                {s.street}<br />{s.zip} {s.city}
              </li>
              <li><a href={href('kontakt#anfahrt')}>Anfahrt &amp; Karte</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {s.businessName || 'Hero4Paws'} · {s.legalName}</span>
          <span>
            <a href={href('impressum')}>Impressum</a> ·
            <a href={href('datenschutz')}>Datenschutz</a> ·
            <a href={href('agb')}>AGB</a>
          </span>
        </div>
      </div>
    </footer>

    <a class="whatsapp-float" href={`https://wa.me/${wa}`} aria-label="Per WhatsApp schreiben">
      <svg viewBox="0 0 448 512" aria-hidden="true"
        ><path
          d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        /></svg
      >
      WhatsApp
    </a>

    <script src={`${import.meta.env.BASE_URL}assets/js/main.js`}></script>
  </body>
</html>
